# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Must already exist; it is created and filled by the ingestion pipeline.
QDRANT_COLLECTION=knowledge

# Embeddings: any OpenAI-compatible /v1/embeddings server.
# Must be the same model the ingestion pipeline used.
# Local vLLM:
EMBEDDING_BASE_URL=http://localhost:8000/v1
EMBEDDING_API_KEY=EMPTY
EMBEDDING_MODEL=BAAI/bge-m3
# OpenAI instead:
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_MODEL=text-embedding-3-large

# MCP server (streamable HTTP at http://MCP_HOST:MCP_PORT/mcp)
MCP_HOST=127.0.0.1
MCP_PORT=8765